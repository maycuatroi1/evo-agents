# Variables of a hub on one machine (deploy/hub/docker-compose.single.yml, docs/self-host.md). Copy this file to
# deploy/hub/.env, fill in the empty values and keep the copy out of git. deploy/hub/.env.example describes every other
# variable the hub reads; add one here to set it.

# The release whose images to run: a tag of https://github.com/maycuatroi1/evo-agents/releases without the v.
EVO_HUB_VERSION=0.58.1

# The two names of this machine: the hub's, and the blob store's for presigned URLs. Both must point at this machine
# before the first start, so the proxy can get their certificates. Under .localhost they need no DNS, for a trial.
EVO_HUB_DOMAIN=hub.example.org
EVO_HUB_S3_DOMAIN=s3.hub.example.org
EVO_HUB_PUBLIC_URL=https://${EVO_HUB_DOMAIN}
EVO_HUB_S3_ENDPOINT=https://${EVO_HUB_S3_DOMAIN}

# GitHub logins that are hub admins, separated by commas.
EVO_HUB_ADMINS=

# The GitHub OAuth App people sign in with: device flow on, callback URL ${EVO_HUB_PUBLIC_URL}/v1/auth/web/callback.
EVO_HUB_GITHUB_CLIENT_ID=
EVO_HUB_GITHUB_CLIENT_SECRET=

# Secrets of this hub alone; generate each one, never copy one from another hub or from an example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'   # EVO_HUB_SESSION_SECRET
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'   # each of the other four
EVO_HUB_SESSION_SECRET=
EVO_HUB_SECRETS_KEY=
EVO_HUB_PLUGIN_HOST_TOKEN=
EVO_HUB_POSTGRES_PASSWORD=
EVO_HUB_S3_SECRET_ACCESS_KEY=

# The database inside the stack. A password from the command above needs no escaping in the URL.
EVO_HUB_DSN=postgresql://hub:${EVO_HUB_POSTGRES_PASSWORD}@evo-agents-hub-postgres:5432/evo_hub

# The blob store inside the stack (docker-compose.seaweedfs.yml): the bucket and the key id are names, not secrets.
EVO_HUB_S3_BUCKET=evo-agents-hub
EVO_HUB_S3_ACCESS_KEY_ID=evo-agents-hub

# The plugin host inside the stack.
EVO_HUB_PLUGIN_HOST_URL=http://evo-agents-hub-plugins:8090

# The time zone of dates the web renders, and of quiet hours until a member chooses one.
EVO_HUB_WEB_TIME_ZONE=UTC
