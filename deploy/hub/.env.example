# Variables of deploy/hub/docker-compose.yml. As it stands this file runs the local stack of
# docker-compose.dev.yml (Postgres and moto inside the stack, nothing real):
#
#   docker compose -f deploy/hub/docker-compose.yml -f deploy/hub/docker-compose.dev.yml \
#     --env-file deploy/hub/.env.example up -d --build
#
# In production set the same names in the platform's environment, never in a committed file. docs/hub.md says what
# each one does. Empty means unset.

# Image tag of ghcr.io/maycuatroi1/evo-agents-hub and evo-agents-hub-web: a release's tag without the v.
# The dev stack builds and tags its images "local".
EVO_HUB_VERSION=local

# Postgres (required). Production: the platform's database. Dev: the postgres service of docker-compose.dev.yml.
EVO_HUB_DSN=postgresql://hub:dev-only-password@postgres:5432/evo_hub
# Docker network on which that database is reached (production default: dokploy-network). The dev stack makes its own.
EVO_HUB_PLATFORM_NETWORK=

# GitHub logins that are hub admins, separated by commas.
EVO_HUB_ADMINS=

# Sign-in: the OAuth App's client id (device flow for the CLI, web flow for the browser), its client secret (web
# flow only), a random secret of at least 32 characters for the session cookie and CSRF tokens
# (python -c 'import secrets; print(secrets.token_urlsafe(48))'), and the URL browsers use for the hub.
# Without the client id nobody can sign in; without the other three the web sign-in answers 503.
EVO_HUB_GITHUB_CLIENT_ID=
EVO_HUB_GITHUB_CLIENT_SECRET=
EVO_HUB_SESSION_SECRET=
EVO_HUB_PUBLIC_URL=http://localhost:3000

# Blob store: an S3 API, Cloudflare R2 in production (https://<account id>.r2.cloudflarestorage.com and a token
# limited to the bucket). All four or none; without them the blob routes answer 503 and the worker does not start.
EVO_HUB_S3_ENDPOINT=http://moto:5000
EVO_HUB_S3_BUCKET=evo-agents-hub-dev
EVO_HUB_S3_ACCESS_KEY_ID=dev-only-key-id
EVO_HUB_S3_SECRET_ACCESS_KEY=dev-only-secret-key
# Optional: where the api and the worker reach the same store themselves, such as its address on the platform's
# network when EVO_HUB_S3_ENDPOINT is a public hostname behind a proxy that caps a request's body (Cloudflare: 100 MB).
# Presigned URLs keep EVO_HUB_S3_ENDPOINT. Empty: the hub calls EVO_HUB_S3_ENDPOINT too.
EVO_HUB_S3_INTERNAL_ENDPOINT=

# Optional: Sentry DSN for errors, and the log level (DEBUG, INFO, WARNING, ERROR).
EVO_HUB_SENTRY_DSN=
EVO_HUB_LOG_LEVEL=INFO

# Optional: how many uploads one process checks and copies in the blob store at once, every commit together.
EVO_HUB_BLOB_CONCURRENCY=32

# Optional: how many of each project's newest built graphs keep their artifact in the blob store; the hourly
# retention deletes the artifacts of older ones. At least 1.
EVO_HUB_KG_KEEP_ARTIFACTS=3

# Optional: days the events of a finished worker run are kept; the daily pruning deletes older ones. 1 to 3650.
EVO_HUB_RUN_LOG_DAYS=30

# Optional: days an audit row is kept; the daily pruning deletes older ones. 30 to 3650, default 365.
EVO_HUB_AUDIT_DAYS=

# Optional: days a session's transcript is kept after its last part came; the daily pruning deletes the content of
# older ones. 30 to 3650, default 365.
EVO_HUB_TRANSCRIPT_DAYS=

# Optional: the connection pool of the api and of the worker: its smallest and largest size, and the seconds a request
# waits for a connection (defaults 1, 10 and 10).
EVO_HUB_POOL_MIN_SIZE=
EVO_HUB_POOL_MAX_SIZE=
EVO_HUB_POOL_TIMEOUT=

# Optional: seconds a claim and each heartbeat of a worker daemon lease a run for before the reaper finds it lost, 5 to
# 3600 (default 300); keep it well above the daemon's heartbeat of 15 seconds. And seconds a plan run waits for its
# owner's answer before the reaper parks it, 1 to 604800 (default 86400, a day).
EVO_HUB_RUN_LEASE_SECONDS=
EVO_HUB_DECISION_WAIT_SECONDS=

# Optional: credentials of worker runs (docs/credentials.md). The key that seals the secrets members keep on the hub
# and the tokens it leases: 32 random bytes in base64url (python -c 'import secrets; print(secrets.token_urlsafe(32))').
# It is not in the database or its dumps: keep it in the platform's environment and the operator's secret store, since
# a dump and the key together open every secret. Without it writing a secret answers 503 and runs get no lease.
EVO_HUB_SECRETS_KEY=
# The GitHub App that makes each run a token for its repos only: its ID (or client ID) and its private key, the
# whole .pem file, on one line with \n between its lines. Both or neither; without them runs get no GitHub token.
EVO_HUB_GITHUB_APP_ID=
EVO_HUB_GITHUB_APP_PRIVATE_KEY=
# The Curator's own GitHub App, evo-agents-curator (docs/curator.md): the runs of the Curator get their tokens from it
# alone, and the hub checks with it that each repo's ruleset keeps it off the default branch. Its ID (or client ID)
# and private key, as above; both or neither. Without them no run of the Curator gets a GitHub token.
EVO_HUB_CURATOR_APP_ID=
EVO_HUB_CURATOR_APP_PRIVATE_KEY=

# Optional: the Telegram channel (docs/notifications.md). The token of the hub's one bot, as @BotFather gives it, and a
# random secret Telegram sends back with every update (1 to 256 characters of A-Z, a-z, 0-9, _ and -, such as
# python -c 'import secrets; print(secrets.token_urlsafe(32))'). Both or the channel is off and the hub runs without it;
# then `evo-agents hub admin telegram --set-webhook` points the bot at EVO_HUB_PUBLIC_URL/v1/telegram/webhook.
EVO_HUB_TELEGRAM_BOT_TOKEN=
EVO_HUB_TELEGRAM_WEBHOOK_SECRET=

# Optional: the publishers whose signed plugin bundles the hub accepts (docs/hub.md, Plugins), comma-separated
# ID=sigstore:OWNER/REPO/.github/workflows/FILE.yml (a GitHub Actions workflow that signs keyless with Sigstore) or
# ID=ed25519:KEY (a public key, 32 bytes in base64, for a hub that cannot reach Sigstore). Empty trusts nobody, and
# every bundle is refused. The core publishers are ids among them whose plugins may run Python in the hub's processes.
EVO_HUB_PLUGIN_PUBLISHERS=
EVO_HUB_PLUGIN_CORE_PUBLISHERS=

# Optional: the plugin host that runs the backends of isolated plugins, apart from the api and the worker and holding
# none of the hub's secrets (docs/plugins.md). Where the api reaches it on the stack network, and a random secret of at
# least 32 characters the api and the host share (python -c 'import secrets; print(secrets.token_urlsafe(32))'), which
# no file shows: generate your own, the hub refuses a value an example ever held. Both or the api runs no isolated
# backend, and the "plugins" service, the same image with the command `evo-agents hub plugin-host`, idles.
EVO_HUB_PLUGIN_HOST_URL=http://evo-agents-hub-plugins:8090
EVO_HUB_PLUGIN_HOST_TOKEN=

# Optional: the reverse proxies whose X-Forwarded-For the api believes, IP addresses or networks separated by commas,
# or *. List only the address the proxy reaches the api from (docs/hub.md, Deploying); empty trusts no proxy beyond the
# loopback addresses.
EVO_HUB_FORWARDED_ALLOW_IPS=

# The worker's limits: CPUs and memory for knowledge graph builds.
EVO_HUB_WORKER_CPUS=2
EVO_HUB_WORKER_MEMORY=4g

# The plugins service's limits, every isolated plugin's backend together: CPUs, memory and processes.
EVO_HUB_PLUGINS_CPUS=1
EVO_HUB_PLUGINS_MEMORY=2g
EVO_HUB_PLUGINS_PIDS=2048

# Web: where its server reaches the api inside the stack, and the time zone of dates it renders.
EVO_HUB_API_INTERNAL_URL=http://evo-agents-hub-api:8080
EVO_HUB_WEB_TIME_ZONE=Asia/Ho_Chi_Minh

# Dev stack only (docker-compose.dev.yml): the local Postgres and the host ports of the api and the web.
EVO_HUB_DEV_POSTGRES_USER=hub
EVO_HUB_DEV_POSTGRES_PASSWORD=dev-only-password
EVO_HUB_DEV_POSTGRES_DB=evo_hub
EVO_HUB_DEV_API_PORT=8080
EVO_HUB_DEV_WEB_PORT=3000
