{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maycuatroi1/evo-agents/schemas/plugin-market-v1.json",
  "title": "market.json",
  "description": "The index of a plugin market (seam plugin-market-v1): a GitHub repo that lists plugins, where each one's code lives, who publishes and signs it, and what it costs. A hub reads it from the market's repo; the bundles themselves come from each plugin's GitHub Releases.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "owner",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "description": "The version of this format.",
      "const": "plugin-market-v1"
    },
    "name": {
      "description": "The market's short name, as hubs show it beside each plugin.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "owner": {
      "description": "Who runs the market.",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "sellers": {
      "description": "The sellers a paid plugin names: where a hub buys a license and the public keys its licenses are signed with.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/seller"
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]{1,500}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "signer": {
      "description": "The identity that signs the publisher's releases: sigstore:OWNER/REPO/.github/workflows/FILE.yml, a GitHub Actions workflow, or ed25519:KEY, a public key in base64.",
      "type": "string",
      "pattern": "^(sigstore:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml|ed25519:[A-Za-z0-9+/_=-]{40,50})$"
    },
    "seller": {
      "type": "object",
      "required": [
        "id",
        "url",
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "keys": {
          "description": "The Ed25519 keys the seller signs licenses with, newest last; an old key stays listed while its licenses run.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key_id",
              "public_key"
            ],
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "description": "ed25519: and the first 16 hex digits of the key's SHA-256.",
                "type": "string",
                "pattern": "^ed25519:[0-9a-f]{16}$"
              },
              "public_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/_=-]{40,50}$"
              },
              "since": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      }
    },
    "price": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "free"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "usd_per_hub_month",
            "seller"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "subscription"
            },
            "usd_per_hub_month": {
              "description": "US dollars a hub pays each month, with at most two decimals.",
              "type": "number",
              "minimum": 0.01,
              "maximum": 100000
            },
            "seller": {
              "description": "The id of a seller in sellers.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "industries",
        "repo",
        "publisher",
        "tier",
        "price"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The plugin's id, as its manifest has it.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "industries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "repo": {
          "description": "OWNER/REPO on GitHub, whose Releases carry the bundle <id>-<version>.tar.gz and its signature <id>-<version>.tar.gz.sigstore.json.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "publisher": {
          "type": "object",
          "required": [
            "id",
            "signer"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "The publisher the manifest names.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "signer": {
              "$ref": "#/$defs/signer"
            }
          }
        },
        "tier": {
          "description": "isolated: installed from the market at run time. core: built into the hub's image, which the market only describes.",
          "enum": [
            "isolated",
            "core"
          ]
        },
        "package": {
          "description": "For a core plugin, the Python distribution that ships it in the image.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "icon": {
          "description": "The name of a lucide icon, or the https URL of a square image.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            {
              "$ref": "#/$defs/url"
            }
          ]
        },
        "requires": {
          "description": "The evo-agents versions the plugin runs on, a range as a manifest's engines has it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "homepage": {
          "$ref": "#/$defs/url"
        },
        "license": {
          "description": "An SPDX expression of the code's license.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
