{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maycuatroi1/evo-agents/schemas/intake2.schema.json",
  "title": "evo-intake/2",
  "description": "What a member's session made of an intake (I-n): everything of evo-intake/1 (candidate problems, promises, questions) plus candidate opportunities with their evidence. Sent with `evo-agents hub intake put I-n FILE`; a document of evo-intake/1 is still accepted, checked by intake.schema.json.",
  "type": "object",
  "required": [
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "evo-intake/2"
    },
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "description": "problems the sources show; a candidate with one source nobody confirmed is refused",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence"
        ],
        "properties": {
          "matches": {
            "type": "string",
            "pattern": "^P-[1-9][0-9]{0,8}$",
            "description": "the code of the problem of the project this one is (P-3): its lines are proposed as evidence of it"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "who": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "workaround": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "confirmed_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "description": "the login of a member of the project who confirmed the candidate, which lets one source stand"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_kind",
                "source_uri",
                "excerpt",
                "signal",
                "label"
              ],
              "properties": {
                "source_kind": {
                  "enum": [
                    "hub_chat",
                    "messenger",
                    "chat_fpt",
                    "email",
                    "file",
                    "harness",
                    "other"
                  ]
                },
                "source_uri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "signal": {
                  "enum": [
                    "complaint",
                    "workaround",
                    "repeated_request",
                    "blocker",
                    "commitment",
                    "proposed_solution",
                    "contradiction",
                    "decision_without_reason"
                  ]
                },
                "label": {
                  "enum": [
                    "public",
                    "internal"
                  ],
                  "description": "a personal line stays on the member's machine"
                }
              }
            }
          },
          "basis": {
            "type": "object",
            "additionalProperties": false,
            "description": "for a new problem, where each of its four fields comes from: a quote of at most 300 characters from a source, or \"inferred\" when the session concluded it without one",
            "properties": {
              "statement": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "who": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "when": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "workaround": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "description": "a candidate without `matches` is a new problem: it says statement, who, when and workaround, each with its basis (a quote or inferred); the hub checks it, as this validator has no conditions"
      }
    },
    "promises": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "promiser": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "who promised: a login of a member, or any name"
          },
          "due": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "the date, when the sources give or imply one"
          },
          "delivery_seen": {
            "type": "boolean",
            "description": "true when the session saw evidence that it was delivered"
          },
          "delivery_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "description": "which source it came from"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "for": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "maxItems": 50,
      "description": "opportunities the sources show; each becomes a proposal of @builder, kind opportunity",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence"
        ],
        "description": "a candidate without `matches` is a new opportunity: it says statement, beneficiary and leverage, each with its basis (a quote or inferred); it needs a line showing demand (external_demand, pull, repeated_request, complaint, blocker or workaround) or an answers code, and a line showing leverage (reusable_asset or idle_capacity), unless a member of the project confirmed it; the hub checks it, as this validator has no conditions",
        "properties": {
          "matches": {
            "type": "string",
            "pattern": "^O-[1-9][0-9]{0,8}$",
            "description": "the code of the opportunity of the project this one is (O-3): its lines are proposed as evidence of it"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "what could be won"
          },
          "beneficiary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "who benefits, in the project or outside it"
          },
          "leverage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "what the project has that makes it reachable now"
          },
          "window_until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "the date after which it is gone; needs a line of signal window"
          },
          "window_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "answers": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9-]{0,99}/)?P-[1-9][0-9]{0,8}$"
            },
            "description": "problems it answers: P-3 of this project, or <project>/P-3 of another one the writer holds a grant on"
          },
          "confirmed_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "description": "the login of a member of the project who confirmed the candidate, which lifts the rule of demand and leverage"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_kind",
                "source_uri",
                "excerpt",
                "signal",
                "label"
              ],
              "properties": {
                "source_kind": {
                  "enum": [
                    "hub_chat",
                    "messenger",
                    "chat_fpt",
                    "email",
                    "file",
                    "harness",
                    "other"
                  ]
                },
                "source_uri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "signal": {
                  "enum": [
                    "complaint",
                    "workaround",
                    "repeated_request",
                    "blocker",
                    "commitment",
                    "proposed_solution",
                    "contradiction",
                    "decision_without_reason",
                    "wish",
                    "external_demand",
                    "window",
                    "reusable_asset",
                    "pull",
                    "intro",
                    "idle_capacity"
                  ]
                },
                "label": {
                  "enum": [
                    "public",
                    "internal"
                  ],
                  "description": "a personal line stays on the member's machine"
                }
              }
            }
          },
          "basis": {
            "type": "object",
            "additionalProperties": false,
            "description": "for a new opportunity, where each field comes from: a quote of at most 300 characters from a source, or \"inferred\" when the session concluded it without one",
            "properties": {
              "statement": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "beneficiary": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "leverage": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "window_until": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              },
              "window_note": {
                "oneOf": [
                  {
                    "const": "inferred"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quote"
                    ],
                    "properties": {
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
