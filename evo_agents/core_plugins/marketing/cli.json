[
  {
    "name": "channels",
    "help": "the accounts with their mode and breaker",
    "project": true,
    "http": {
      "method": "GET",
      "path": "channels"
    },
    "output": {
      "render": "text",
      "json": "array",
      "keys": [
        "id",
        "channel",
        "account",
        "kind",
        "mode",
        "adapter",
        "owner",
        "target",
        "paused",
        "paused_reason",
        "autonomous_since",
        "session_state",
        "account_kind",
        "health",
        "health_reason",
        "health_checked_at"
      ],
      "schema": "MarketingChannel"
    }
  },
  {
    "name": "add",
    "help": "make a channel account, draft_only (a project account: an admin)",
    "project": true,
    "http": {
      "method": "POST",
      "path": "channels"
    },
    "args": [
      {
        "name": "channel",
        "type": "string",
        "in": "body",
        "required": true,
        "choices": [
          "github",
          "hackernews",
          "reddit",
          "x",
          "linkedin",
          "viblo",
          "facebook_page",
          "facebook_profile",
          "tiktok",
          "facebook_group"
        ],
        "help": "the channel"
      },
      {
        "name": "account",
        "type": "string",
        "in": "body",
        "required": true,
        "help": "the handle, page or repo it posts as"
      },
      {
        "name": "kind",
        "type": "string",
        "in": "body",
        "choices": [
          "project",
          "personal"
        ],
        "default": "project",
        "help": "whose account (project)"
      },
      {
        "name": "adapter",
        "type": "string",
        "in": "body",
        "choices": [
          "api",
          "browser"
        ],
        "help": "how it posts; the channel's default when none"
      },
      {
        "name": "target",
        "type": "string",
        "in": "body",
        "help": "a subreddit, a page id, owner/name, an author urn"
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "id",
        "channel",
        "account",
        "kind",
        "mode",
        "adapter",
        "owner",
        "target",
        "paused",
        "paused_reason",
        "autonomous_since",
        "session_state",
        "account_kind",
        "health",
        "health_reason",
        "health_checked_at"
      ],
      "schema": "MarketingChannel"
    }
  },
  {
    "name": "check",
    "help": "check the health of the accounts, posting nothing (admin)",
    "project": true,
    "http": {
      "method": "POST",
      "path": "check"
    },
    "args": [
      {
        "name": "channel_id",
        "flag": "--channel-id",
        "type": "integer",
        "in": "body",
        "metavar": "ID",
        "help": "one channel; none checks every one"
      }
    ],
    "output": {
      "render": "text",
      "json": "array",
      "keys": [
        "id",
        "channel",
        "account",
        "kind",
        "mode",
        "adapter",
        "owner",
        "target",
        "paused",
        "paused_reason",
        "autonomous_since",
        "session_state",
        "account_kind",
        "health",
        "health_reason",
        "health_checked_at"
      ],
      "schema": "MarketingChannel"
    }
  },
  {
    "name": "posts",
    "help": "the posts with their state and reason",
    "project": true,
    "http": {
      "method": "GET",
      "path": "posts"
    },
    "args": [
      {
        "name": "state",
        "type": "string",
        "in": "query",
        "choices": [
          "proposed",
          "judging",
          "queued",
          "posting",
          "posted",
          "draft",
          "failed",
          "withdrawn"
        ],
        "help": "only posts in this state"
      }
    ],
    "output": {
      "render": "text",
      "json": "array",
      "keys": [
        "id",
        "channel_id",
        "channel",
        "account",
        "kind",
        "body",
        "links",
        "state",
        "reason",
        "layers",
        "judge",
        "run_id",
        "posted_url",
        "cost_usd",
        "dry_run",
        "created_at",
        "posted_at",
        "claim_id",
        "signal_key",
        "scheduled_at"
      ],
      "schema": "MarketingPost"
    }
  },
  {
    "name": "mode",
    "help": "switch an account to autonomous or draft_only (a member, never an agent)",
    "project": true,
    "http": {
      "method": "PUT",
      "path": "channels/{channel_id}/mode"
    },
    "args": [
      {
        "name": "channel_id",
        "type": "integer",
        "in": "path",
        "positional": true,
        "required": true,
        "metavar": "CHANNEL_ID"
      },
      {
        "name": "mode",
        "type": "string",
        "in": "body",
        "positional": true,
        "required": true,
        "choices": [
          "autonomous",
          "draft_only"
        ],
        "help": "autonomous drafts only during the dry run"
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "id",
        "channel",
        "account",
        "kind",
        "mode",
        "adapter",
        "owner",
        "target",
        "paused",
        "paused_reason",
        "autonomous_since",
        "session_state",
        "account_kind",
        "health",
        "health_reason",
        "health_checked_at"
      ],
      "schema": "MarketingChannel"
    }
  },
  {
    "name": "pause",
    "help": "open the breaker of one channel",
    "project": true,
    "http": {
      "method": "POST",
      "path": "channels/{channel_id}/pause"
    },
    "args": [
      {
        "name": "reason",
        "type": "string",
        "in": "body",
        "default": "stopped by hand",
        "help": "why, kept in the audit"
      },
      {
        "name": "channel_id",
        "type": "integer",
        "in": "path",
        "positional": true,
        "required": true,
        "metavar": "CHANNEL_ID"
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "ok"
      ],
      "schema": "MarketingDone"
    }
  },
  {
    "name": "resume",
    "help": "close the breaker of a channel, or clear the kill switch (admin)",
    "project": true,
    "http": {
      "method": "POST",
      "path": "resume"
    },
    "args": [
      {
        "name": "channel_id",
        "type": "integer",
        "in": "path",
        "positional": true,
        "required": false,
        "metavar": "CHANNEL_ID",
        "help": "the channel; none clears the kill switch"
      }
    ],
    "when": [
      {
        "arg": "channel_id",
        "http": {
          "method": "POST",
          "path": "channels/{channel_id}/resume"
        }
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "ok"
      ],
      "schema": "MarketingDone"
    }
  },
  {
    "name": "kill",
    "help": "stop every channel of the project",
    "project": true,
    "http": {
      "method": "POST",
      "path": "kill"
    },
    "args": [
      {
        "name": "reason",
        "type": "string",
        "in": "body",
        "default": "stopped by hand",
        "help": "why, kept in the audit"
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "ok"
      ],
      "schema": "MarketingDone"
    }
  },
  {
    "name": "denylist",
    "help": "the terms, domains and people no post may name (an admin edits it)",
    "project": true,
    "http": {
      "method": "GET",
      "path": "denylist"
    },
    "args": [
      {
        "name": "add",
        "type": "string",
        "in": "body",
        "values": [
          "kind",
          "value"
        ],
        "group": "edit",
        "help": "deny a value; KIND is one of term, domain, person"
      },
      {
        "name": "remove",
        "type": "integer",
        "in": "path",
        "group": "edit",
        "metavar": "ID",
        "help": "remove the entry with this id"
      }
    ],
    "when": [
      {
        "arg": "add",
        "http": {
          "method": "POST",
          "path": "denylist"
        }
      },
      {
        "arg": "remove",
        "http": {
          "method": "DELETE",
          "path": "denylist/{remove}"
        }
      }
    ],
    "output": {
      "render": "text",
      "json": "array",
      "keys": [
        "id",
        "kind",
        "value",
        "added_at"
      ],
      "schema": "MarketingDeny"
    }
  },
  {
    "name": "browser-post",
    "help": "post the oldest queued post of a browser channel (needs Chromium)",
    "project": true,
    "client": "browser_post",
    "http": {
      "method": "POST",
      "path": "browser/claim"
    },
    "output": {
      "json": "object",
      "keys": [
        "state",
        "reason"
      ],
      "schema": "MarketingBrowserResult"
    }
  },
  {
    "name": "login",
    "help": "log in once in a browser and seal the session of a channel",
    "project": true,
    "client": "browser_login",
    "http": {
      "method": "POST",
      "path": "channels/{channel_id}/session"
    },
    "args": [
      {
        "name": "channel_id",
        "type": "integer",
        "in": "path",
        "positional": true,
        "required": true,
        "metavar": "CHANNEL_ID"
      }
    ],
    "output": {
      "json": "object",
      "keys": [
        "id",
        "channel",
        "account",
        "kind",
        "mode",
        "adapter",
        "owner",
        "target",
        "paused",
        "paused_reason",
        "autonomous_since",
        "session_state",
        "account_kind",
        "health",
        "health_reason",
        "health_checked_at"
      ],
      "schema": "MarketingChannel"
    }
  }
]
