[
  {
    "name": "list",
    "help": "the contacts and how many are in each stage",
    "project": true,
    "http": {
      "method": "GET",
      "path": "contacts"
    },
    "args": [
      {
        "name": "stage",
        "type": "string",
        "in": "query",
        "choices": [
          "lead",
          "invited",
          "activated",
          "retained"
        ],
        "help": "only contacts in this stage"
      },
      {
        "name": "source",
        "type": "string",
        "in": "query",
        "choices": [
          "invite_request",
          "invite_link",
          "grant",
          "issue",
          "pull_request",
          "discussion"
        ],
        "help": "only contacts first seen from this source"
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "project",
        "counts",
        "contacts"
      ],
      "schema": "CrmContacts"
    }
  },
  {
    "name": "show",
    "help": "one contact with its touchpoints and the stages it reached",
    "project": true,
    "http": {
      "method": "GET",
      "path": "contacts/{login}"
    },
    "args": [
      {
        "name": "login",
        "type": "string",
        "in": "path",
        "positional": true,
        "required": true,
        "help": "the contact's GitHub login"
      }
    ],
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "login",
        "profile_url",
        "source",
        "stage",
        "first_seen_at",
        "stage_at",
        "touchpoints",
        "history"
      ],
      "schema": "CrmContactDetail"
    }
  },
  {
    "name": "delete",
    "help": "delete a contact on its request, with every touchpoint (admin)",
    "project": true,
    "http": {
      "method": "DELETE",
      "path": "contacts/{login}"
    },
    "args": [
      {
        "name": "login",
        "type": "string",
        "in": "path",
        "positional": true,
        "required": true,
        "help": "the contact's GitHub login"
      }
    ],
    "confirm": {
      "flag": "--yes",
      "text": "Delete {login} from project {project} with every touchpoint? This cannot be undone. Run again with --yes."
    },
    "output": {
      "render": "text",
      "json": "object",
      "keys": [
        "deleted",
        "touchpoints"
      ],
      "schema": "CrmDeleted"
    }
  }
]
