{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "evo-agents kg hook session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_evo-kg_evo-kg__.*",
        "hooks": [
          {
            "type": "command",
            "command": "evo-agents kg hook post-tool || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "evo-agents kg hook post-search || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rg *)",
            "command": "evo-agents kg hook post-search --only rg || true",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "evo-agents kg hook post-search --only grep || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
