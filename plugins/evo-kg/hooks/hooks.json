{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "command -v evo-agents >/dev/null 2>&1 && evo-agents kg hook session-start || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
