{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/evo-ak\" kg hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_evo-kg_evo-kg__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/evo-ak\" kg hook post-tool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/evo-ak\" kg hook post-search",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(rg *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/evo-ak\" kg hook post-search --only rg",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/evo-ak\" kg hook post-search --only grep",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
